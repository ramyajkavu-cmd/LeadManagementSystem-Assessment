<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Lead Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">Lead Management</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="Leads" asp-action="Index">Leads</a>
                <a class="nav-link" asp-controller="Leads" asp-action="Create">Add Lead</a>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="ms-auto">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-light btn-sm">Logout</button>
            </form>
        </div>
    </nav>
}
<div class="container py-4">
    @RenderBody()
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
